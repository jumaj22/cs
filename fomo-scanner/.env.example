# ─── Copie ce fichier en ".env" puis remplis les valeurs. Ne le commite JAMAIS. ───

# Telegram (obligatoire pour recevoir les alertes) — voir README, étape 3
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Helius (obligatoire pour le suivi smart money Solana) — voir README, étape 4
HELIUS_API_KEY=

# Birdeye (optionnel : améliore la découverte de wallets « top traders ») — voir README, étape 5
BIRDEYE_API_KEY=

# GoPlus (optionnel : l'API publique marche sans clé, avec des limites plus basses)
GOPLUS_ACCESS_TOKEN=

# Webhooks Helius (optionnel, uniquement si smartMoney.monitor.mode = "webhook")
# URL publique joignable par Helius, ex. https://xxxx.ngrok-free.app/helius
PUBLIC_WEBHOOK_URL=
# Secret libre que Helius renverra dans l'en-tête Authorization
HELIUS_WEBHOOK_AUTH=

# Niveau de logs : debug | info | warn | error
LOG_LEVEL=info
